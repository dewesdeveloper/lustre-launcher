{
  "name": "lustre-frontend",
  "productName": "Lustre",
  "private": true,
  "version": "0.1.4",
  "releaseName": "Public 0.1.4",
  "license": "GPL-3.0-or-later",
  "author": "DewesDeveloper",
  "description": "Lustre desktop app",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --strictPort\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:cache": "node scripts/dev/build-cache-test.cjs && node scripts/dev/cache-race-test.bundle.mjs",
    "preview": "vite preview",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder",
    "release": "node scripts/release.cjs",
    "build:beta": "node scripts/check-api-url.cjs && npm run build",
    "dist:beta": "npm run build:beta && electron-builder",
    "build:web": "node scripts/check-api-url.cjs && tsc -b && vite build --base=/ --outDir dist-web && node scripts/seo-prerender.cjs",
    "publish:apk": "node scripts/publish-apk.cjs",
    "deploy:web": "node scripts/deploy-web.cjs",
    "admin:pull": "node scripts/admin-sync.cjs pull",
    "admin:push": "node scripts/admin-sync.cjs push"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "7zip-bin": "^5.2.0",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.7.3",
    "livekit-client": "^2.22.3",
    "lucide-react": "^1.31.0",
    "megajs": "1.3.10",
    "motion": "^13.1.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-quill-new": "^3.8.3",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "uint8-util": "^2.1.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "com.lustrehub.lustre-frontend",
    "productName": "Lustre",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/**/*"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/7zip-bin/**",
      "node_modules/uiohook-napi/**",
      "electron/translator/**"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lustre",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "protocols": [
      {
        "name": "Lustre",
        "schemes": [
          "lustre"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "dewesdeveloper",
      "repo": "lustre-launcher",
      "releaseType": "release"
    },
    "extraFiles": [
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ]
  }
}
